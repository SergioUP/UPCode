# Optional: UPCode Connect source builds
# `cp .env.example .env` enables UPCode Connect against the production deployment.
# These are the same public identifiers baked into official release builds, not
# secrets. Remove or comment them out to build with cloud features disabled.
# Do not add server-side secrets to this file.

# Production Clerk instance. To use your own, get these from the Clerk Dashboard
# under API keys, JWT templates, and OAuth applications.
UPCODE_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsudDMuY29kZXMk
UPCODE_CLERK_JWT_TEMPLATE=upcode-relay
UPCODE_CLERK_CLI_OAUTH_CLIENT_ID=hzxSgY2cH10sDU2r

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in UPCODE_CLERK_PUBLISHABLE_KEY. Set the override only when Clerk
# returns a different RP ID or when multiple domains must be entitled.
# UPCODE_APPLE_TEAM_ID=ABC1234567
# UPCODE_MACOS_PROVISIONING_PROFILE=/absolute/path/to/upcode.provisionprofile
# UPCODE_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Production relay endpoint baked into official builds. The relay service is not
# part of this repository; point this at whichever relay you operate.
UPCODE_RELAY_URL=https://relay.upcode.codes

# Optional: hosted app origin used by the CLI's out-of-band OAuth flow.
# Defaults to https://app.upcode.codes; override to test against a staging deployment.
# UPCODE_HOSTED_APP_URL=https://nightly.app.upcode.codes

# Public, ingest-only mobile OpenTelemetry configuration.
# UPCODE_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# UPCODE_MOBILE_OTLP_TRACES_DATASET=upcode-mobile-traces-dev
# UPCODE_MOBILE_OTLP_TRACES_TOKEN=xaat-...
